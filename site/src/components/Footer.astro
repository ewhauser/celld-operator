---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default />
<p class="site-notice">
    Experimental software for evaluation.
    <a href={`${import.meta.env.BASE_URL}reference/limitations/`}>Capabilities and limitations</a>
    · <a href={`${import.meta.env.BASE_URL}contribute/`}>Contribute</a>
</p>

<style>
	.site-notice {
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
