{
  "repository": "ewhauser/celld-operator",
  "actions": {
    "enabled": true,
    "allowed_actions": "all",
    "sha_pinning_required": true
  },
  "workflow": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "fork_approval": {
    "approval_policy": "all_external_contributors"
  },
  "rulesets": [
    {
      "name": "main",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "~DEFAULT_BRANCH"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": true,
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": true
          }
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": true,
            "do_not_enforce_on_create": false,
            "required_status_checks": [
              {
                "context": "build",
                "integration_id": 15368
              },
              {
                "context": "test",
                "integration_id": 15368
              },
              {
                "context": "lint",
                "integration_id": 15368
              },
              {
                "context": "chart",
                "integration_id": 15368
              },
              {
                "context": "security",
                "integration_id": 15368
              },
              {
                "context": "kind (lifecycle)",
                "integration_id": 15368
              }
            ]
          }
        }
      ],
      "bypass_actors": []
    },
    {
      "name": "immutable-tags",
      "target": "tag",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "~ALL"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "update"
        },
        {
          "type": "non_fast_forward"
        }
      ],
      "bypass_actors": []
    },
    {
      "name": "release-tags-require-approval",
      "target": "tag",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "refs/tags/v*"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "required_deployments",
          "parameters": {
            "required_deployment_environments": [
              "release"
            ]
          }
        }
      ],
      "bypass_actors": []
    },
    {
      "name": "private-security-work",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "refs/heads/advisory-*",
            "refs/heads/ghsa-*",
            "refs/heads/cve-*",
            "refs/heads/internal-*",
            "refs/heads/internal/**/*"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "creation"
        },
        {
          "type": "update"
        }
      ],
      "bypass_actors": []
    }
  ],
  "release_environments": {
    "release": {
      "wait_timer": 0,
      "prevent_self_review": false,
      "reviewers": [
        {
          "type": "User",
          "id": 131389
        }
      ],
      "deployment_branch_policy": {
        "protected_branches": false,
        "custom_branch_policies": true
      },
      "can_admins_bypass": false
    },
    "release-artifacts": {
      "wait_timer": 0,
      "prevent_self_review": false,
      "reviewers": [
        {
          "type": "User",
          "id": 131389
        }
      ],
      "deployment_branch_policy": {
        "protected_branches": false,
        "custom_branch_policies": true
      },
      "can_admins_bypass": false
    }
  }
}
